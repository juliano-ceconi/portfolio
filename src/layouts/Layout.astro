---
import { ViewTransitions } from 'astro:transitions';
import { config, siteCopy } from '../data/config';
import { DEFAULT_LANG, LANGS, htmlLang, ogLocale, pathFor, pick, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = DEFAULT_LANG, ...props } = Astro.props;
const copy = pick(siteCopy, lang);
const { title = copy.siteTitle, description = copy.description } = props;

// URL absoluta: WhatsApp, LinkedIn e X ignoram caminho relativo em og:image.
const ogImage = new URL(config.ogImage[lang], config.siteUrl).href;
const canonical = new URL(Astro.url.pathname, config.siteUrl).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={config.author} />
    <meta name="keywords" content={copy.keywords} />
    <link rel="canonical" href={canonical} />
    {
      LANGS.map((alt) => (
        <link rel="alternate" hreflang={htmlLang[alt]} href={new URL(pathFor(alt), config.siteUrl).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', config.siteUrl).href} />
    <link rel="icon" type="image/svg+xml" href={config.favicon} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:site_name" content={config.author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Tema aplicado antes da pintura e reaplicado depois de trocar de idioma: o
      ViewTransitions substitui os atributos do <html> e apagaria a classe `dark`.
      Script identico nas 3 paginas, entao o Astro o preserva e nao executa duas vezes.
    -->
    <script is:inline>
      (() => {
        const aplicarTema = () => {
          const salvo = localStorage.getItem('theme') ?? 'dark';
          localStorage.setItem('theme', salvo);
          document.documentElement.classList.toggle('dark', salvo === 'dark');
        };

        aplicarTema();

        if (window.__temaPronto) return;
        window.__temaPronto = true;

        document.addEventListener('astro:after-swap', aplicarTema);
        document.addEventListener('click', (evento) => {
          if (!evento.target.closest?.('#theme-toggle')) return;
          const escuro = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', escuro ? 'dark' : 'light');
        });
      })();
    </script>

    <ViewTransitions />
  </head>
  <body>
    <slot />
  </body>
</html>

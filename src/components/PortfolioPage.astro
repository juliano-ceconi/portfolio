---
import { Button } from '@/components/ui/button';
import { MoonIcon, SunIcon } from 'lucide-react';
import Hero from '@/components/Hero';
import Experience from '@/components/Experience';
import PortfolioFeed from '@/components/PortfolioFeed';
import SitesFeed from '@/components/SitesFeed';
import Education from '@/components/Education';
import Footer from '@/components/Footer';
import { DEFAULT_LANG, LANGS, htmlLang, langCode, langName, pathFor, type Lang } from '@/i18n';
import { ui } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;
const t = ui(lang);
---

<main class="min-h-screen bg-background">
  <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
    <nav
      aria-label={t.languageSelector}
      class="flex items-center gap-1 rounded-full border border-input bg-background p-1"
    >
      {
        LANGS.map((idioma) => (
          <a
            href={pathFor(idioma)}
            lang={htmlLang[idioma]}
            hreflang={htmlLang[idioma]}
            aria-current={idioma === lang ? 'page' : undefined}
            class:list={[
              'rounded-full px-2.5 py-1.5 text-xs font-medium transition-colors',
              idioma === lang
                ? 'bg-accent text-accent-foreground'
                : 'hover:bg-accent hover:text-accent-foreground',
            ]}
          >
            <span aria-hidden="true">{langCode[idioma]}</span>
            <span class="sr-only">{langName[idioma]}</span>
          </a>
        ))
      }
    </nav>
    <Button variant="outline" size="icon" className="rounded-full" id="theme-toggle">
      <SunIcon className="h-[2.2rem] w-[2.2rem] rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" />
      <MoonIcon className="absolute h-[2.2rem] w-[2.2rem] rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" />
      <span class="sr-only">{t.themeToggle}</span>
    </Button>
  </div>
  <Hero client:load lang={lang} />
  <SitesFeed client:visible lang={lang} />
  <Experience client:visible lang={lang} />
  <PortfolioFeed client:visible lang={lang} />
  <Education client:visible lang={lang} />
  <Footer client:visible lang={lang} />
</main>
